# Runtime
NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# PostgreSQL
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://recruitment:replace-with-a-local-development-password@localhost:5432/recruitment
TEST_DATABASE_URL=postgresql://recruitment:replace-with-a-local-development-password@localhost:5432/recruitment_test
PRISMA_LOG_QUERIES=false

# Authentication (backend login/JWT/RBAC implemented; use a random production secret)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
SEED_ADMIN_PASSWORD=replace-with-a-local-development-admin-password
SEED_RECRUITER_PASSWORD=replace-with-a-local-development-recruiter-password
SEED_INTERVIEWER_PASSWORD=replace-with-a-local-development-interviewer-password

# Resume processing and storage
RESUME_SERVICE_URL=http://localhost:8000
RESUME_SERVICE_PORT=8000
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_RESUME_SIZE_BYTES=10485760

# Email provider abstraction (implemented in Phase 7)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=recruitment@example.test
