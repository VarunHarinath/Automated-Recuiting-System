{
  "name": "automated-recruitment-system",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @ars/api --filter @ars/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm -r check",
    "typecheck": "tsc --noEmit",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:test": "DATABASE_URL=$TEST_DATABASE_URL vitest run apps/api/tests/database/database.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prisma": "6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "argon2": "^0.44.0",
    "zod": "^4.0.17"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
